# BelegBot — Env-Vorlage (git-sicher, keine echten Secrets)
# Kopiere zu ".env" und trage echte Werte ein.

# Datenbank (Hetzner PostgreSQL, Shared mit TeamPortal)
DATABASE_URL=postgresql://teamportal_app:PASSWORT@178.105.135.102:5432/teamportal?sslmode=require
DATABASE_URL_ADMIN=postgresql://moritz_admin:PASSWORT@178.105.135.102:5432/teamportal?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=min-32-zeichen-zufaellig
BETTER_AUTH_URL=http://localhost:3002
BETTER_AUTH_TRUSTED_ORIGINS=
BELEGBOT_INGEST_SECRET=min-32-zeichen-zufaellig

# Zugriffskontrolle (nur diese beiden E-Mails duerfen rein)
BELEGBOT_LENA_EMAIL=reising.lena@web.de
BELEGBOT_MORITZ_EMAIL=

# MinIO / S3 (Belege)
BELEGBOT_S3_ENDPOINT=https://s3.aurora-showcase.de
BELEGBOT_S3_BUCKET=belegbot
BELEGBOT_S3_ACCESS_KEY=
BELEGBOT_S3_SECRET_KEY=

# Claude (Beleg-Extraktion)
ANTHROPIC_API_KEY=sk-ant-...

# Telegram-Bot (nativer Webhook, ersetzt n8n)
# Telegram-User-IDs → Admin-Panel (/admin), nicht via Env.
BELEGBOT_TELEGRAM_BOT_TOKEN=
BELEGBOT_TELEGRAM_WEBHOOK_SECRET=min-32-zeichen-zufaellig
