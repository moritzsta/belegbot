# BelegBot — Vorlage für Umgebungsvariablen
# Kopiere diese Datei zu ".env" und trage die echten Werte ein.
# ".env" wird von Git ignoriert (.gitignore), ".env.example" wird committet.

# Supabase Anon Key
# Findest du in deiner Supabase-Konfiguration (docker-compose oder .env des Supabase-Setups)
VITE_SUPABASE_ANON_KEY=dein-supabase-anon-key-hier

# Anthropic API Key (nur für lokalen Vite-Proxy nötig)
# In Production wird der Key in der Apache-Config eingetragen — nie im Code!
# Holen unter: https://console.anthropic.com → API Keys
VITE_ANTHROPIC_API_KEY=sk-ant-api03-...
